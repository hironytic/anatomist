{
  "name": "@hironytic/anatomist",
  "version": "0.1.0",
  "description": "A framework for building binary file inspector tools",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "sandbox": "npm run dev --prefix sandbox",
    "sandbox:build": "npm run build --prefix sandbox",
    "sandbox:typecheck": "npm run typecheck --prefix sandbox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0"
    }
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
